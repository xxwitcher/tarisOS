@@ -316,8 +316,21 @@
     return _currentScreen->getLines() + _currentScreen->getHistLines();
 }
 
+// Taris: the terminal is drawn inside the shell's full-screen surface, so every update
+// redraws the whole screen in the shell and the compositor. While a program streams output,
+// show its screen at most ~30 times a second (still immediate to the eye) instead of up to ~100.
+static const int MIN_BULK_INTERVAL = 33;
+
 void Emulation::showBulk()
 {
+    if (_lastBulk.isValid() && _lastBulk.elapsed() < MIN_BULK_INTERVAL)
+    {
+        _bulkTimer1.setSingleShot(true);
+        _bulkTimer1.start(MIN_BULK_INTERVAL - static_cast<int>(_lastBulk.elapsed()));
+        return;
+    }
+    _lastBulk.start();
+
     _bulkTimer1.stop();
     _bulkTimer2.stop();
 
