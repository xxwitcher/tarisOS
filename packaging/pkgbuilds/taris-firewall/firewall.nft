# TarisOS's firewall: nothing gets in unless it answers something this machine started (or is
# local); everything may go out. Loaded at boot by taris-firewall.service; nothing keeps running.

destroy table inet taris_firewall

table inet taris_firewall {
	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop
		iif lo accept

		# IPv6 can't work without ICMPv6 (neighbour discovery, router adverts); pings are answered
		meta l4proto ipv6-icmp accept
		meta l4proto icmp accept

		# DHCPv6 replies to this machine's own requests
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
	}
}
