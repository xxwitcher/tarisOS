# TarisOS's Chromium settings for every account (Google sign-in, saved passwords in the keyring,
# the web app windows' extension, software rendering without a GPU, for VS Code too), applied at
# each login by chromium-flags.

pkgname=taris-chromium
pkgver=1.0.0
pkgrel=1
pkgdesc='TarisOS: Chromium settings for every account'
arch=('any')
url='https://github.com/xxwitcher/tarisOS'
license=('GPL-3.0-only')
depends=('chromium' 'gnome-keyring' 'bash' 'sed')
source=('chromium-flags')
sha256sums=('801bed049ee36230982ec5846213de06189abf19dbd72d5207759e1227ff47c5')

package() {
    install -Dm755 chromium-flags "$pkgdir/usr/lib/taris/chromium-flags"
}
