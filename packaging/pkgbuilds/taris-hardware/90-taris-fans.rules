# Fan control (the bar's fan popout): lets the wheel group set Apple Silicon fan speeds. fanN_target
# only takes writes with macsmc_hwmon.fan_control=1 on the kernel command line (taris-grub.cfg).
ACTION=="add|change", SUBSYSTEM=="hwmon", ATTR{name}=="macsmc_hwmon", RUN+="/usr/bin/sh -c 'for f in /sys%p/fan*_target; do chgrp wheel $f && chmod g+w $f; done'"
