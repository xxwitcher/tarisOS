# TarisOS's desktop: Hyprland's settings and the shell's integration (/usr/share/taris/hypr, so
# updates reach them; each account's own changes go on top), the default apps, the desktop portal's
# file picker, a new account's defaults (colours, wallpapers, web apps, agent skills), the window
# title bar plugin and the system's name. Built from this repository's packaging folder.

pkgname=taris-desktop
pkgver=1.0.0
pkgrel=1
pkgdesc='TarisOS: the Hyprland desktop, its defaults and the system name'
arch=('any')
url='https://github.com/xxwitcher/tarisOS'
license=('GPL-3.0-only')
depends=(
    'taris-shell'
    'hyprland'
    'xdg-desktop-portal-hyprland'
    'xdg-desktop-portal-gtk'
    'gnome-keyring'
    'polkit'
    'glib2'
    'xdg-utils'
    'desktop-file-utils'
    'wl-clipboard'
    'cliphist'
    'adw-gtk-theme'
    'papirus-icon-theme'
    'noto-fonts'
    'noto-fonts-emoji'
    'python'
    'file'
    'curl'
    'bash'

    # The title bar plugin, built for each Hyprland installed
    'jq'
    'make'
    'gcc'
    'pkgconf'
    'binutils'
)
optdepends=(
    'taris-wallpapers: the wallpaper collection'
    'chromium: the browser, and the web apps'
)
backup=('etc/xdg/mimeapps.list' 'etc/xdg/xdg-desktop-portal/hyprland-portals.conf' 'etc/default/grub.d/taris-name.cfg')
source=(
    'user-defaults'
    'name-system'
    'os-release'
    'taris-os-release.hook'
    'taris-hyprbars.hook'
    'taris-hyprbars-remove.hook'
    'taris-name.cfg'
    'hyprland-portals.conf'
    'skel-hyprland.lua'
    'bashrc'
    'mimeapps.list'
    'update'
    'install-on-demand'
    'taris-install-code.desktop'
    'input-method'
    'taris-hyprbars.service'
)
